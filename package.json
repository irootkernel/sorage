{
  "name": "sorage",
  "private": true,
  "version": "0.3.0",
  "description": "Sorage, a local document-handoff broker for AI coding sessions.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "bun": "1.4.0"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "check:toolchain": "bun run scripts/check-toolchain.ts",
    "check:version": "bun run scripts/check-version.ts",
    "check:format": "biome format .",
    "check:lint": "biome lint .",
    "check:typecheck": "bun run scripts/check-typecheck.ts",
    "check:import-boundaries": "bun run scripts/check-import-boundaries.ts",
    "check:dependency-boundaries": "bun run scripts/check-dependency-boundaries.ts",
    "test:unit": "vitest run --config vitest.unit.config.ts",
    "test:int": "vitest run --config vitest.int.config.ts",
    "test:contract": "vitest run --config vitest.contract.config.ts",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "build:cli": "bun run scripts/build-cli.ts",
    "package": "bun run scripts/package.ts",
    "check:sot": "bun run scripts/sot-check.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "2.3.4",
    "@playwright/test": "^1.62.1",
    "@types/bun": "1.2.20",
    "axe-core": "^4.13.0",
    "typescript": "5.9.3",
    "vitest": "3.2.4"
  },
  "dependencies": {
    "commander": "14.0.2"
  }
}
