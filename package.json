{
  "name": "sorage",
  "private": true,
  "version": "0.1.6",
  "description": "Sorage, a local document-handoff broker for AI coding sessions.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "bun": "1.4.2"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "format": "/bin/sh scripts/toolchain.sh script format",
    "check:toolchain": "/bin/sh scripts/toolchain.sh script check:toolchain",
    "check:version": "/bin/sh scripts/toolchain.sh script check:version",
    "check:format": "/bin/sh scripts/toolchain.sh script check:format",
    "check:lint": "/bin/sh scripts/toolchain.sh script check:lint",
    "check:typecheck": "/bin/sh scripts/toolchain.sh script check:typecheck",
    "check:import-boundaries": "/bin/sh scripts/toolchain.sh script check:import-boundaries",
    "check:cycles": "/bin/sh scripts/toolchain.sh script check:cycles",
    "check:dependency-boundaries": "/bin/sh scripts/toolchain.sh script check:dependency-boundaries",
    "test:unit": "/bin/sh scripts/toolchain.sh script test:unit",
    "test:int": "/bin/sh scripts/toolchain.sh script test:int",
    "test:contract": "/bin/sh scripts/toolchain.sh script test:contract",
    "test:e2e": "/bin/sh scripts/toolchain.sh script test:e2e",
    "test:release": "/bin/sh scripts/toolchain.sh script test:release",
    "build:web": "/bin/sh scripts/toolchain.sh script build:web",
    "build:cli": "/bin/sh scripts/toolchain.sh script build:cli",
    "package": "/bin/sh scripts/toolchain.sh script package",
    "check:sot": "/bin/sh scripts/toolchain.sh script check:sot"
  },
  "devDependencies": {
    "@biomejs/biome": "2.3.4",
    "@playwright/test": "^1.62.1",
    "@types/bun": "1.2.20",
    "axe-core": "^4.13.0",
    "typescript": "5.9.3",
    "vitest": "3.2.4"
  },
  "dependencies": {
    "commander": "14.0.2"
  },
  "packageManager": "bun@1.4.2"
}
